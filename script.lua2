InfoLabel.Parent = MainFrame

local function StartTextLoop()
    -- تم استبدال Zennko بـ HM
    local messages = {"تابع حساباتنا التيك", "lemnawarmohamed", "HM", "Follow our TikTok", "lemnawarmohamed", "HM"}
    while true do
        for _, msg in ipairs(messages) do
            InfoLabel.Text = msg
            TweenService:Create(InfoLabel, TweenInfo.new(0.5), {TextTransparency = 0}):Play()
            task.wait(2)
            TweenService:Create(InfoLabel, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
            task.wait(0.6)
        end
    end
end

