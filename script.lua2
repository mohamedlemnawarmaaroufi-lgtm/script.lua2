-----------------------------------------
-- [3] البرمجة والوظائف
-----------------------------------------
local CorrectKey = "ZQHUB_829376_JSORCQ"
local tracking = false
local trackConnection
local currentBind = nil
local isBinding = false

-- الدخول
SubmitKeyBtn.MouseButton1Click:Connect(function()
    if KeyInput.Text == CorrectKey then
        KeyFrame.Visible = false
        MainFrame.Visible = true
        task.spawn(StartTextLoop)
    end
end)

DiscordBtn.MouseButton1Click:Connect(function()
    if setclipboard then setclipboard("https://discord.gg/vuMarNRxH") end
    DiscordBtn.Text = "COPIED!"
    task.wait(2)
    DiscordBtn.Text = "DISCORD"
end)

-- وظيفة التتبع
local function ToggleTrack()
    tracking = not tracking
    if tracking then
        TrackBtn.Text = "Track: ON"
        TrackBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 50)
        trackConnection = RunService.Heartbeat:Connect(function()
            local target = nil
            local dist = math.huge
            local character = LocalPlayer.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then return end
            
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (character.HumanoidRootPart.Position - v.Character.HumanoidRootPart.Position).Magnitude
                    if d < dist then dist = d target = v end
                end
            end
            if target and character:FindFirstChild("Humanoid") then
                if character.Humanoid.MoveDirection.Magnitude == 0 then
                    character.Humanoid:MoveTo(target.Character.HumanoidRootPart.Position)
                end
            end
        end)
    else
        TrackBtn.Text = "Track: OFF"
        TrackBtn.BackgroundColor3 = Color3.fromRGB(70, 20, 110)
        if trackConnection then trackConnection:Disconnect() end
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("Humanoid") then
            character.Humanoid:MoveTo(character.HumanoidRootPart.Position)
        end
    end
end

TrackBtn.MouseButton1Click:Connect(ToggleTrack)

-- نظام تعيين المفتاح (Bind)
BindBtn.MouseButton1Click:Connect(function()
    isBinding = true
    BindBtn.Text = "Press any key..."
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    
    if isBinding and input.UserInputType == Enum.UserInputType.Keyboard then
        currentBind = input.KeyCode
        BindBtn.Text = "Bind: " .. tostring(currentBind.Name)
        isBinding = false
    elseif currentBind and input.KeyCode == currentBind then
        ToggleTrack()
    end
end)
